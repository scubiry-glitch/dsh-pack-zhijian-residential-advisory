{
  "id": "single-home-market-value-reference.output",
  "version": "0.2.0",
  "schemaVersion": 2,
  "media": [
    "markdown"
  ],
  "sections": [
    {
      "id": "subject",
      "required": true,
      "fields": [
        "标的资料、核验状态和测算基准日"
      ]
    },
    {
      "id": "result",
      "required": true,
      "fields": [
        "仅使用市场价值参考测算、咨询测算结果或建议区间"
      ]
    },
    {
      "id": "sale_comparables",
      "required": true,
      "fields": [
        "交易可比的来源、原始值、调整值、入选和排除理由"
      ]
    },
    {
      "id": "same_community_comparison",
      "required": false,
      "fields": [
        "没有同小区样本时明确披露"
      ]
    },
    {
      "id": "reasonableness",
      "required": true,
      "fields": [
        "模型预测与可比基准的合理性对照"
      ]
    },
    {
      "id": "attribution",
      "required": false,
      "fields": [
        "仅解释可用的本地或逐样本归因"
      ]
    },
    {
      "id": "technical_refs",
      "required": true,
      "fields": [
        "query_id、data_version、model_version、inference_id 和 snapshot_schema_version"
      ]
    },
    {
      "id": "limitations",
      "required": true,
      "fields": [
        "咨询边界、资料限制和交付状态"
      ]
    }
  ],
  "renderModes": {
    "discussion": {
      "anonymize": true
    },
    "final": {
      "anonymize": false
    }
  },
  "appliesToScenario": "single-home-market-value-reference",
  "dataRules": {
    "annotationLevels": [
      "verified_fact",
      "user_input",
      "structured_measurement",
      "assumption_or_pending"
    ],
    "sourceFormat": "structured_snapshot 字段路径（来源，口径，截至日期）",
    "forbidFabricatedNumbers": true,
    "notes": "结构化快照是追溯基准；不得将咨询成果表述为法定评估或估价结论；Agent 只可形成内部草稿或待人工复核状态，对外交付必须经授权人工批准。"
  },
  "renderingNotes": "交付前完成内容、计算、合规及逐页渲染复核。"
}
