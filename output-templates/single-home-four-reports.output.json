      "required": true,
      "fields": [
        "price_result",
        "rent_result",
        "price_effective_month",
        "rent_effective_month",
        "stage"
      ]
    },
    {
      "id": "report_files",
      "required": true,
      "fields": [
        "price_full",
        "price_external",
        "rent_full",
        "rent_external"
      ]
    },
    {
      "id": "technical_refs",
      "required": true,
      "fields": [
        "attempt_id",
        "job_id",
        "input_sha256",
