  "appliesToScenario": "single-home-four-reports",
  "dataRules": {
    "notes": "摘要以结构化结果为准；四份 DOCX 是任务附件，非 Markdown 渲染产物。不要求人工批准或报告角色授权。"
  },
  "renderingNotes": "media 为摘要及清单格式；不得据此将 DOCX 转为 Markdown 再重排。四附件链接必须全部展示。"
}
