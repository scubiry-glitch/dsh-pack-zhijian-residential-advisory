{
  "id": "single-home-rent-reference.output",
  "version": "0.3.0",
  "schemaVersion": 2,
  "media": [
    "markdown"
  ],
  "sections": [
    {
      "id": "subject",
      "required": true,
      "fields": [
        "标的资料、租赁用途、核验状态和测算基准日"
      ]
    },
    {
      "id": "result",
      "required": true,
      "fields": [
        "月租金和单位租金参考结果及建议区间"
      ]
    },
    {
      "id": "rent_comparables",
      "required": true,
      "fields": [
        "租赁样本来源类型、原始值、单位值、入选和排除理由"
      ]
    },
    {
      "id": "same_community_comparison",
      "required": false,
      "fields": [
        "没有同小区租赁样本时明确披露"
      ]
    },
    {
      "id": "reasonableness",
      "required": true,
      "fields": [
        "模型预测与租赁可比基准的合理性对照"
      ]
    },
    {
      "id": "attribution",
      "required": false,
      "fields": [
        "仅解释可用的本地租金归因"
      ]
    },
    {
      "id": "technical_refs",
      "required": true,
      "fields": [
        "query_id、data_version、model_version、inference_id 和 snapshot_schema_version"
      ]
    },
    {
      "id": "limitations",
      "required": true,
      "fields": [
        "挂牌、成交、模型来源类型及咨询边界"
      ]
    }
  ],
  "renderModes": {
    "discussion": {
      "anonymize": true
    },
    "final": {
      "anonymize": false
    }
  },
  "appliesToScenario": "single-home-rent-reference",
  "dataRules": {
    "annotationLevels": [
      "verified_fact",
      "user_input",
      "structured_measurement",
      "assumption_or_pending"
    ],
    "sourceFormat": "structured_snapshot 字段路径（来源类型，口径，截至日期）",
    "forbidFabricatedNumbers": true,
    "notes": "结构化快照是追溯基准；挂牌、成交和模型结果不得混用；质量检查通过后直接交付报告，无需人工批准或报告角色分层。"
  },
  "renderingNotes": "交付前完成内容、计算、合规及逐页渲染复核。"
}
