{
  "id": "single-home-hold-return-acquisition.quality",
  "version": "0.2.0",
  "schemaVersion": 2,
  "gates": [
    {
      "id": "city-coverage",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "phase": "data",
      "config": {
        "rules": [
          "价值与租金快照对应的城市和住宅类型必须正式覆盖。"
        ]
      }
    },
    {
      "id": "subject-consistency",
      "kind": "semantic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "phase": "semantic",
      "config": {
        "rules": [
          "价值、租金、经营参数、计算快照和报告标的必须一致。"
        ]
      }
    },
    {
      "id": "published-release-only",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "phase": "data",
      "config": {
        "rules": [
          "正式结果只能绑定已发布的数据、模型和规则版本。"
        ]
      }
    },
    {
      "id": "deterministic-numbers-only",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "phase": "data",
      "config": {
        "rules": [
          "NOI、收益率、DCF、IRR、收购价和敏感性数值必须来自确定性计算快照。"
        ]
      }
    },
    {
      "id": "technical-refs-complete",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "phase": "data",
      "config": {
        "rules": [
          "输入快照、calculation_snapshot_id、规则版本和 Schema 引用必须齐全。"
        ]
      }
    },
    {
      "id": "numbers-match-dataset",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "phase": "data",
      "config": {
        "rules": [
          "报告数字、单位、日期、参数和条件必须与结构化快照一致。"
        ]
      }
    },
    {
      "id": "no-banned-tokens",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "phase": "compliance",
      "config": {
        "rules": [
          "不得将咨询成果表述为法定评估、估价或投资审批结论。"
        ],
        "bannedTokens": [
          "资产评估报告",
          "房地产估价报告",
          "法定评估结论"
        ]
      }
    },
    {
      "id": "delivery-facts-complete",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "config": {
        "rules": [
          "经营参数来源和用户确认状态必须达到交付要求。"
        ]
      }
    },
    {
      "id": "sensitive-content-scan",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "phase": "compliance",
      "config": {
        "rules": [
          "包和输出中不得出现凭据、客户敏感信息或本地绝对路径。"
        ]
      }
    },
    {
      "id": "package-integrity",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "config": {
        "rules": [
          "声明的文件和引用必须存在且可解析。"
        ]
      }
    },
    {
      "id": "render-no-overflow",
      "kind": "visual",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "phase": "format",
      "config": {
        "rules": [
          "DOCX 渲染必须完成逐页检查且无溢出、截断或不可读内容。"
        ]
      }
    },
    {
      "id": "placeholder-clean",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "hard",
      "phase": "structure",
      "config": {
        "rules": [
          "对外交付不得保留模板占位符或待替换文本。"
        ]
      }
    },
    {
      "id": "scenario-coverage",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "soft",
      "phase": "data",
      "config": {
        "rules": [
          "基础、压力和其他已配置情景的适用边界清楚呈现。"
        ]
      }
    },
    {
      "id": "sensitivity-explanation",
      "kind": "deterministic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "soft",
      "config": {
        "rules": [
          "敏感性只解释确定性输出，不增加语言模型计算。"
        ]
      }
    },
    {
      "id": "outline-match",
      "kind": "semantic",
      "appliesTo": [
        "deliverable"
      ],
      "severity": "soft",
      "phase": "semantic",
      "config": {
        "rules": [
          "章节与持有收益及收购价输出模板逐项对应。"
        ]
      }
    }
  ],
  "maxRepairRounds": 2,
  "appliesToScenario": "single-home-hold-return-acquisition",
  "notes": "任一硬门不通过时不得形成对外定稿；修复轮次耗尽后转人工处理，并建议在目标平台保存哈希、抽样截图和 GATE 文件。"
}
